{
  "family": "myapp-backend",
  "taskRoleArn": "arn:aws:iam::835756672944:role/myapp-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::835756672944:role/myapp-ecs-execution-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "<BACKEND_IMAGE>",
      "cpu": 0,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "AWS_DEFAULT_REGION", "value": "ap-south-1" },
        { "name": "AWS_REGION", "value": "ap-south-1" },
        { "name": "DB_HOST", "value": "<DB_HOST>" },
        { "name": "DB_PORT", "value": "<DB_PORT>" },
        { "name": "DB_NAME", "value": "<DB_NAME>" },
        { "name": "DB_USER", "value": "<DB_USER>" },
        { "name": "DB_PASSWORD", "value": "<DB_PASSWORD>" }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/myapp/backend",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "backend"
        }
      },
      "systemControls": []
    }
  ],
  "tags": [
    {
      "key": "Name",
      "value": "myapp-backend-task"
    }
  ]
}
