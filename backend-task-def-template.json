{
    "family": "staff-app-backend",
    "taskRoleArn": "arn:aws:iam::835756672944:role/ecsTaskExecutionRole",
    "executionRoleArn": "arn:aws:iam::835756672944:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "2048",
    "containerDefinitions": [
        {
            "name": "backend",
            "image": "<BACKEND_IMAGE>",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 5000,
                    "hostPort": 5000,
                    "protocol": "tcp",
                    "name": "backend-5000-tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "PORT",
                    "value": "5000"
                },
                {
                    "name": "NODE_ENV",
                    "value": "production"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "secrets": [
                {
                    "name": "DB_NAME",
                    "valueFrom": "arn:aws:secretsmanager:ap-south-1:835756672944:secret:prod/myapp/secrets-mmGfqR:DB_NAME::"
                },
                {
                    "name": "DB_PASSWORD",
                    "valueFrom": "arn:aws:secretsmanager:ap-south-1:835756672944:secret:prod/myapp/secrets-mmGfqR:DB_PASSWORD::"
                },
                {
                    "name": "DB_USER",
                    "valueFrom": "arn:aws:secretsmanager:ap-south-1:835756672944:secret:prod/myapp/secrets-mmGfqR:DB_USER::"
                },
                {
                    "name": "REDIS_HOST",
                    "valueFrom": "arn:aws:secretsmanager:ap-south-1:835756672944:secret:prod/myapp/secrets-mmGfqR:REDIS_HOST::"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/staff-app-backend",
                    "awslogs-create-group": "true",
                    "awslogs-region": "ap-south-1",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            },
            "systemControls": []
        },
        {
            "name": "postgres",
            "image": "postgres:15-alpine",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 5432,
                    "hostPort": 5432,
                    "protocol": "tcp",
                    "name": "postgres-5432-tcp"
                }
            ],
            "essential": true,
            "environment": [],
            "mountPoints": [],
            "volumesFrom": [],
            "secrets": [
                {
                    "name": "POSTGRES_DB",
                    "valueFrom": "arn:aws:secretsmanager:ap-south-1:835756672944:secret:prod/myapp/secrets-mmGfqR:DB_NAME::"
                },
                {
                    "name": "POSTGRES_PASSWORD",
                    "valueFrom": "arn:aws:secretsmanager:ap-south-1:835756672944:secret:prod/myapp/secrets-mmGfqR:DB_PASSWORD::"
                },
                {
                    "name": "POSTGRES_USER",
                    "valueFrom": "arn:aws:secretsmanager:ap-south-1:835756672944:secret:prod/myapp/secrets-mmGfqR:DB_USER::"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/staff-app-postgres",
                    "awslogs-create-group": "true",
                    "awslogs-region": "ap-south-1",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            },
            "systemControls": []
        },
        {
            "name": "redis",
            "image": "redis:alpine",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 6379,
                    "hostPort": 6379,
                    "protocol": "tcp",
                    "name": "redis-6379-tcp"
                }
            ],
            "essential": true,
            "environment": [],
            "mountPoints": [],
            "volumesFrom": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/staff-app-redis",
                    "awslogs-create-group": "true",
                    "awslogs-region": "ap-south-1",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            },
            "systemControls": []
        }
    ]
}
