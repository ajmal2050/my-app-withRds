{
  "family": "myapp-backend",
  "taskRoleArn": "arn:aws:iam::835756672944:role/myapp-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::835756672944:role/myapp-ecs-execution-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "<BACKEND_IMAGE>",
      "cpu": 0,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "AWS_DEFAULT_REGION", "value": "ap-south-1" },
        { "name": "AWS_REGION", "value": "ap-south-1" }
      ],
      "secrets": [
        {
          "name": "DB_HOST",
          "valueFrom": "<APP_SECRET_ARN>:DB_HOST::"
        },
        {
          "name": "DB_NAME",
          "valueFrom": "<APP_SECRET_ARN>:DB_NAME::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "<APP_SECRET_ARN>:DB_PASSWORD::"
        },
        {
          "name": "DB_PORT",
          "valueFrom": "<APP_SECRET_ARN>:DB_PORT::"
        },
        {
          "name": "DB_USER",
          "valueFrom": "<APP_SECRET_ARN>:DB_USERNAME::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/myapp/backend",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "backend"
        }
      }
    }
  ]
}
